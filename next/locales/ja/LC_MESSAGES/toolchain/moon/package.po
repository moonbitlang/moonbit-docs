#~ msgid ""
#~ "The `is-main` field is the legacy"
#~ " way to specify whether a package "
#~ "needs to be linked into an "
#~ "executable file. Prefer `pkgtype(kind: "
#~ "\"executable\")`."
#~ msgstr ""

#~ msgid ""
#~ "By default, moon only links packages "
#~ "where `is-main` is set to `true`."
#~ " If you need to link other "
#~ "packages, you can specify this with "
#~ "the `link` option."
#~ msgstr ""

#~ msgid ""
#~ "All alerts has a category associated "
#~ "with it, which is customized by "
#~ "the author of the API. You can "
#~ "enable or disable specific alert "
#~ "categories using the `alert_<category>` "
#~ "warning name, or use `alert` to "
#~ "control all alert warnings at once."
#~ msgstr ""

#~ msgid ""
#~ "For example, in the following "
#~ "configuration, all warnings for alerts "
#~ "are treated  as fatal errors, except "
#~ "for the `unsafe` category, which is "
#~ "disabled."
#~ msgstr ""

#~ msgid "warnings = \"@alert-alert_unsafe\" \n"
#~ msgstr ""

#~ msgid ""
#~ "{\n"
#~ "  \"warn-list\": \"@alert-alert_unsafe\" \n"
#~ "}\n"
#~ msgstr ""

#~ msgid "moon fmt -C <module_dir>\n"
#~ msgstr ""

#~ msgid ""
#~ "The `supported-targets` option declares "
#~ "which backends a package is intended "
#~ "to support. It uses a target-set"
#~ " expression, not an array:"
#~ msgstr ""

#~ msgid ""
#~ "options(\n"
#~ "  \"supported-targets\": \"js\",\n"
#~ ")\n"
#~ msgstr ""

#~ msgid "use `supported-targets` to declare the package's supported backend set"
#~ msgstr ""

#~ msgid ""
#~ "When both the module and the "
#~ "package declare `supported-targets`, the "
#~ "effective backend set is their "
#~ "intersection."
#~ msgstr ""

#~ msgid "omitting `supported-targets` means all backends are supported"
#~ msgstr ""

#~ msgid "`llvm` is still a valid `supported-targets` value"
#~ msgstr ""

#~ msgid "mark a native-only package with `\"supported-targets\": \"native\"`"
#~ msgstr ""

#~ msgid ""
#~ "You can also use warning numbers "
#~ "in `warn-list`. In the output "
#~ "below, `mnemonic` is the symbolic "
#~ "warning name used in warning lists, "
#~ "while `id` is the numeric form of"
#~ " the same warning."
#~ msgstr ""

#~ msgid ""
#~ "Used to disable warnings, enable "
#~ "warnings, or treat a warning as a"
#~ " fatal error. The warning list is "
#~ "a string composed of multiple warning"
#~ " name, each prefixed with a sign:"
#~ msgstr ""

#~ msgid "`@` to treat the enabled warning as a fatal error (deprecated)"
#~ msgstr ""

#~ msgid ""
#~ "The `@` switch is deprecated. Use "
#~ "`moon check --deny-warn` (and the "
#~ "equivalent flag on other CI commands)"
#~ " when warnings should fail the build."
#~ " Existing `@` configuration is shown "
#~ "here only for migration."
#~ msgstr ""

#~ msgid "warnings = \"@deprecated\"\n"
#~ msgstr ""

#~ msgid ""
#~ "{\n"
#~ "  \"warn-list\": \"@deprecated\"\n"
#~ "}\n"
#~ msgstr ""

