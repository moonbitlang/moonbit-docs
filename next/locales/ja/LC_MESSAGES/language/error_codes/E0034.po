#: ../../language/error_codes/E0034.md:1
msgid "E0034"
msgstr ""

#: ../../language/error_codes/E0034.md:3
msgid "Warning name: `implicit_use_builtin`"
msgstr "警告名：`implicit_use_builtin`"

#: ../../language/error_codes/E0034.md:5
msgid ""
"This warning was used for constructors implicitly resolved from "
"`moonbitlang/core/builtin`."
msgstr "この警告は、`moonbitlang/core/builtin` から暗黙に解決されるコンストラクタに対して使用されていました。"

#: ../../language/error_codes/E0034.md:8
msgid ""
"Current MoonBit no longer emits this warning. Its number and warning name"
" remain listed for compatibility, but unqualified builtin constructors do"
" not require a migration."
msgstr ""
"現在の MoonBit はこの警告を発しません。番号と警告名は互換性のために引き続き掲載されていますが、"
"修飾されていない builtin コンストラクタを移行する必要はありません。"

#~ msgid "Implicit use of definitions from `moonbitlang/core/builtin`."
#~ msgstr ""

#~ msgid ""
#~ "This warning is emitted when code "
#~ "implicitly relies on definitions from "
#~ "`moonbitlang/core/builtin`. Consider importing the"
#~ " desired APIs explicitly to make "
#~ "dependencies clearer."
#~ msgstr ""

#~ msgid "Erroneous example"
#~ msgstr ""

#~ msgid ""
#~ "Here `Null` is inferred as the "
#~ "`Json::Null` constructor from "
#~ "`moonbitlang/core/builtin` without an explicit "
#~ "type or qualification:"
#~ msgstr ""

#~ msgid ""
#~ "///|\n"
#~ "pub fn check(value : Json) -> Int {\n"
#~ "  fn classify(input) {\n"
#~ "    match input {\n"
#~ "      Null => 0\n"
#~ "      _ => 1\n"
#~ "    }\n"
#~ "  }\n"
#~ "\n"
#~ "  classify(value)\n"
#~ "}\n"
#~ msgstr ""

#~ msgid "Suggestion"
#~ msgstr ""

#~ msgid ""
#~ "Make the builtin dependency explicit and"
#~ " qualify the constructor, or otherwise "
#~ "add enough type information that the "
#~ "code no longer relies on implicit "
#~ "builtin constructor inference."
#~ msgstr ""

#~ msgid ""
#~ "///|\n"
#~ "pub fn check(value : Json) -> Int {\n"
#~ "  fn classify(input : Json) {\n"
#~ "    match input {\n"
#~ "      Json::Null => 0\n"
#~ "      _ => 1\n"
#~ "    }\n"
#~ "  }\n"
#~ "\n"
#~ "  classify(value)\n"
#~ "}\n"
#~ msgstr ""
