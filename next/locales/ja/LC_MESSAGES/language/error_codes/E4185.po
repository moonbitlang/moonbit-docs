#: ../../language/error_codes/E4185.md:1
msgid "E4185"
msgstr ""

#: ../../language/error_codes/E4185.md:3
msgid "Compiler diagnostic name: `invalid_lex_pattern`."
msgstr ""

#: ../../language/error_codes/E4185.md:5
msgid ""
"This diagnostic described the earlier string-piece `lexmatch` pattern "
"shape and is not emitted by the current compiler."
msgstr ""

#: ../../language/error_codes/E4185.md:8
msgid ""
"Current lexical cases contain one regex constant expression, optionally "
"with `as`, `before=`, and `after=` bindings supported by the selected "
"matching mode."
msgstr ""

#: ../../language/error_codes/E4185.md:11
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4185.md:13
msgid "The following pattern has too many top-level pieces:"
msgstr ""

#: ../../language/error_codes/E4185.md:15
msgid ""
"///|\n"
"fn classify(input : String) -> String {\n"
"  lexmatch input with longest {\n"
"    (\"a\", before, \"b\", after) => before.to_owned() + after.to_owned()"
"\n"
"    _ => \"none\"\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  ignore(classify)\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4185.md:19
msgid "Current code should use the regex-case syntax instead."
msgstr ""

#: ../../language/error_codes/E4185.md:21
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4185.md:23
msgid ""
"Use a current `lexmatch` case pattern, or a regex match expression when "
"only a boolean result is needed:"
msgstr ""

#: ../../language/error_codes/E4185.md:26
msgid ""
"///|\n"
"fn classify(input : String) -> String {\n"
"  if input =~ (re\"a\" + re\"b\", before~, after~) {\n"
"    before.to_owned() + after.to_owned()\n"
"  } else {\n"
"    \"none\"\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  inspect(classify(\"xabz\"), content=\"xz\")\n"
"}\n"
msgstr ""
