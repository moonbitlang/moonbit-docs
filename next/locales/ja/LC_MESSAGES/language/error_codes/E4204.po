#: ../../language/error_codes/E4204.md:1
msgid "E4204"
msgstr ""

#: ../../language/error_codes/E4204.md:3
msgid "Compiler diagnostic name: `loop_nobreak_not_supported`."
msgstr ""

#: ../../language/error_codes/E4204.md:5
msgid ""
"This diagnostic applies to a `nobreak` clause on the deprecated "
"functional-loop syntax. Use a `for` loop with explicit state bindings "
"instead."
msgstr "この診断は、非推奨の関数型ループ構文に付けられた `nobreak` 節に対して出力されます。代わりに、状態を明示的に束縛する `for` ループを使ってください。"

#: ../../language/error_codes/E4204.md:8
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4204.md:10
msgid ""
"Use `break` with a value to return the result. A `for` loop without a "
"condition continues until an explicit exit, so no `nobreak` clause is "
"needed:"
msgstr "値を伴う `break` で結果を返します。条件のない `for` ループは明示的に終了するまで続くため、`nobreak` 節は不要です。"

#: ../../language/error_codes/E4204.md:13
msgid ""
"///|\n"
"fn count_down(n : Int32) -> Int32 {\n"
"  for i = n {\n"
"    if i == 0 {\n"
"      break 0\n"
"    }\n"
"    continue i - 1\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  inspect(count_down(3), content=\"0\")\n"
"}\n"
msgstr ""

#~ msgid "Erroneous example"
#~ msgstr ""
