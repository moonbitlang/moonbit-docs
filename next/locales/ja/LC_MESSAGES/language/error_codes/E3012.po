#: ../../language/error_codes/E3012.md:1
msgid "E3012"
msgstr ""

#: ../../language/error_codes/E3012.md:3
msgid ""
"Struct pattern and map pattern cannot be mixed. The key in map pattern "
"must be a literal, while the key in struct pattern must be the field "
"name."
msgstr ""

#: ../../language/error_codes/E3012.md:6
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E3012.md:8
msgid ""
"///|\n"
"test {\n"
"  let map : Map[String, Int32] = { \"value\": 42 }\n"
"  match map {\n"
"    { \"value\": value, value, .. } => println(\"Value is: \\{value}\") "
"// Error: Struct pattern and map pattern cannot be mixed.\n"
"    _ => println(\"No value\")\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E3012.md:12
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E3012.md:14
msgid "Use a map pattern for a standard-library `Map`:"
msgstr "標準ライブラリの `Map` にはマップパターンを使用します："

#: ../../language/error_codes/E3012.md:16
msgid ""
"///|\n"
"fn use_map_pattern(map : Map[String, Int32]) -> Unit {\n"
"  match map {\n"
"    { \"value\": value, .. } => println(\"Value is: \\{value}\")\n"
"    _ => println(\"No value\")\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  let map : Map[String, Int32] = { \"value\": 42 }\n"
"  use_map_pattern(map)\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E3012.md:20
msgid "Or use a struct pattern for a struct value:"
msgstr "構造体の値には構造体パターンを使用します："

#: ../../language/error_codes/E3012.md:22
msgid ""
"///|\n"
"priv struct S {\n"
"  value : Int32\n"
"}\n"
"\n"
"///|\n"
"fn use_struct_pattern(s : S) -> Unit {\n"
"  match s {\n"
"    { value, } => println(\"Value is: \\{value}\")\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  use_struct_pattern({ value: 42, })\n"
"}\n"
msgstr ""
