#: ../../language/error_codes/E4155.md:1
msgid "E4155"
msgstr ""

#: ../../language/error_codes/E4155.md:3
msgid "Cycle in a `const` or type alias declaration."
msgstr "`const` または型エイリアスの宣言に循環があります。"

#: ../../language/error_codes/E4155.md:5
msgid ""
"Constants and type aliases can refer to other declarations in the same "
"package, but the references must not form a cycle."
msgstr "定数と型エイリアスは同じパッケージ内の別の宣言を参照できますが、その参照が循環してはいけません。"

#: ../../language/error_codes/E4155.md:8
msgid "Erroneous example"
msgstr "誤った例"

#: ../../language/error_codes/E4155.md:10
msgid ""
"///|\n"
"const A : Int = B + 1\n"
"\n"
"///|\n"
"const B : Int = A + 1\n"
"\n"
"///|\n"
"type T1 = T2\n"
"\n"
"///|\n"
"type T2 = T1\n"
msgstr ""

#: ../../language/error_codes/E4155.md:14
msgid "Suggestion"
msgstr "修正案"

#: ../../language/error_codes/E4155.md:16
msgid "Break the cycle so that every constant and type alias eventually resolves to a concrete value or type."
msgstr "循環を解消し、各定数と型エイリアスが最終的に具体的な値または型へ解決されるようにしてください。"

#: ../../language/error_codes/E4155.md:19
msgid ""
"///|\n"
"const A : Int = 1\n"
"\n"
"///|\n"
"const B : Int = A + 1\n"
"\n"
"///|\n"
"type T1 = Int\n"
"\n"
"///|\n"
"type T2 = T1\n"
"\n"
"///|\n"
"fn use_declarations(value : T2) -> Int {\n"
"  value + B\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  assert_eq(use_declarations(A), 3)\n"
"}\n"
msgstr ""
