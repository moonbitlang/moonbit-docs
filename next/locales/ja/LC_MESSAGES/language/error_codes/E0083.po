#: ../../language/error_codes/E0083.md:1
msgid "E0083"
msgstr ""

#: ../../language/error_codes/E0083.md:3
msgid "Warning name: `type_param_method`"
msgstr ""

#: ../../language/error_codes/E0083.md:5
msgid ""
"Calling a trait method on a type parameter through deprecated implicit "
"method resolution."
msgstr ""

#: ../../language/error_codes/E0083.md:8
msgid ""
"When a method comes from a supertrait of the written constraint, or a "
"type parameter has multiple trait bounds that could supply methods, dot "
"syntax does not make the selected trait explicit. Use "
"`Trait::method(value, ...)` instead."
msgstr ""

#: ../../language/error_codes/E0083.md:12
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E0083.md:14
msgid ""
"///|\n"
"pub(open) trait Position {\n"
"  fn pos(Self) -> (Int, Int)\n"
"}\n"
"\n"
"///|\n"
"pub(open) trait Object: Position {}\n"
"\n"
"///|\n"
"pub fn[O : Object] position_of(object : O) -> (Int, Int) {\n"
"  object.pos()\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0083.md:18
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E0083.md:20
msgid "Qualify the method with the trait that declares it."
msgstr ""

#: ../../language/error_codes/E0083.md:22
msgid ""
"///|\n"
"pub(open) trait Position {\n"
"  fn pos(Self) -> (Int, Int)\n"
"}\n"
"\n"
"///|\n"
"pub(open) trait Object: Position {}\n"
"\n"
"///|\n"
"pub fn[O : Object] position_of(object : O) -> (Int, Int) {\n"
"  Position::pos(object)\n"
"}\n"
msgstr ""
