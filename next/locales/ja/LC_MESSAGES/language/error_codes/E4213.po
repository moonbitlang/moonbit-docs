#: ../../language/error_codes/E4213.md:1
msgid "E4213"
msgstr ""

#: ../../language/error_codes/E4213.md:3
msgid "Compiler diagnostic name: `invalid_constr_self_type`."
msgstr ""

#: ../../language/error_codes/E4213.md:5
msgid ""
"Custom constructors cannot be defined for trait object types such as "
"`&Trait`."
msgstr ""

#: ../../language/error_codes/E4213.md:7
msgid ""
"MoonBit supports custom constructors for user-defined concrete types, "
"including structs, enums, and newtypes. A trait object is an erased "
"runtime view rather than a concrete type that can own a constructor, so "
"`fn &Trait::Trait(...)` is rejected."
msgstr ""

#: ../../language/error_codes/E4213.md:12
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4213.md:14
msgid ""
"///|\n"
"pub(open) trait Renderable {\n"
"  fn render(Self) -> String\n"
"}\n"
"\n"
"///|\n"
"pub fn[X : Renderable] &Renderable::Renderable(value : X) -> &Renderable "
"{\n"
"  value as &Renderable\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4213.md:18
msgid ""
"The erroneous example tries to make `&Renderable::Renderable` a "
"constructor for the trait object type."
msgstr ""

#: ../../language/error_codes/E4213.md:21
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4213.md:23
msgid ""
"Use a normal function to convert a value to the trait object, or define a"
" custom constructor on a concrete wrapper type."
msgstr ""

#: ../../language/error_codes/E4213.md:26
msgid ""
"///|\n"
"pub(open) trait Renderable {\n"
"  fn render(Self) -> String\n"
"}\n"
"\n"
"///|\n"
"pub fn[X : Renderable] as_renderable(value : X) -> &Renderable {\n"
"  value as &Renderable\n"
"}\n"
msgstr ""

#~ msgid "Compiler diagnostic name: `constr_for_non_struct`."
#~ msgstr ""

#~ msgid "Constructor methods can only be defined for `struct` types."
#~ msgstr ""

#~ msgid ""
#~ "MoonBit's `Type::Type` constructor mechanism "
#~ "belongs to structs. Enums, newtypes, and"
#~ " other type forms already have their"
#~ " own construction syntax, so a "
#~ "constructor method for those types is"
#~ " rejected."
#~ msgstr ""

#~ msgid ""
#~ "pub enum Status {\n"
#~ "  Ready\n"
#~ "}\n"
#~ "\n"
#~ "pub fn Status::Status() -> Status {\n"
#~ "  Ready\n"
#~ "}\n"
#~ msgstr ""

#~ msgid ""
#~ "`Status` is an `enum`, not a "
#~ "`struct`, so `Status::Status` cannot be "
#~ "used as a struct constructor."
#~ msgstr ""

#~ msgid ""
#~ "Use the enum constructor directly, or"
#~ " change the type to a `struct` "
#~ "if you need a custom constructor "
#~ "method."
#~ msgstr ""

#~ msgid ""
#~ "pub struct Status {}\n"
#~ "\n"
#~ "pub fn Status::Status() -> Status {\n"
#~ "  Status::{  }\n"
#~ "}\n"
#~ msgstr ""
