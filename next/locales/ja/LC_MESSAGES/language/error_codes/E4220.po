#: ../../language/error_codes/E4220.md:1
msgid "E4220"
msgstr ""

#: ../../language/error_codes/E4220.md:3
msgid "Compiler diagnostic name: `regex_match_binding_not_supported`."
msgstr ""

#: ../../language/error_codes/E4220.md:5
msgid ""
"A `lexscan ... with longest` case uses a `before=` binding, which is not "
"available in longest-match mode."
msgstr ""

#: ../../language/error_codes/E4220.md:8
msgid ""
"For `String` and `StringView` inputs, first-match mode supports both "
"`before=` and `after=`. Longest-match mode starts at the beginning of the"
" input, so it supports `after=` but not `before=`."
msgstr ""

#: ../../language/error_codes/E4220.md:12
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4220.md:14
msgid ""
"///|\n"
"pub fn first_word(input : String) -> StringView {\n"
"  lexscan input with longest {\n"
"    (re\"^[a-z]+\" as word, before=_) => word\n"
"    _ => \"\"\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4220.md:18
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4220.md:20
msgid ""
"Remove `before=`, anchor the regex at `^`, and use `after=` when the "
"unmatched suffix is needed."
msgstr ""

#: ../../language/error_codes/E4220.md:23
msgid ""
"///|\n"
"pub fn first_word(input : String) -> StringView {\n"
"  lexscan input with longest {\n"
"    (re\"^[a-z]+\" as word, after=_) => word\n"
"    _ => \"\"\n"
"  }\n"
"}\n"
msgstr ""
