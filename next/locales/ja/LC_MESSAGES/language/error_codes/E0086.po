#: ../../language/error_codes/E0086.md:1
msgid "E0086"
msgstr ""

#: ../../language/error_codes/E0086.md:3
msgid "Warning name: `unlabelled_continue_in_labelled_loop`"
msgstr "警告名：`unlabelled_continue_in_labelled_loop`"

#: ../../language/error_codes/E0086.md:5
msgid "An unlabelled `continue` appears directly inside a labelled loop."
msgstr "ラベル付きループの直下に、ラベルのない `continue` があります。"

#: ../../language/error_codes/E0086.md:7
msgid "Erroneous example"
msgstr "誤った例"

#: ../../language/error_codes/E0086.md:9
msgid ""
"///|\n"
"pub fn skip_all() -> Unit {\n"
"  outer~: for i = 0; i < 3; i = i + 1 {\n"
"    ignore(i)\n"
"    continue\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0086.md:13
msgid "Suggestion"
msgstr "修正方法"

#: ../../language/error_codes/E0086.md:15
msgid "Name the loop explicitly in the `continue`."
msgstr "`continue` でループのラベルを明示します。"

#: ../../language/error_codes/E0086.md:17
msgid ""
"///|\n"
"pub fn skip_all() -> Unit {\n"
"  outer~: for i = 0; i < 3; i = i + 1 {\n"
"    ignore(i)\n"
"    continue outer~\n"
"  }\n"
"}\n"
msgstr ""
