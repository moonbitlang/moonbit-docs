#: ../../language/error_codes/E4219.md:1
msgid "E4219"
msgstr ""

#: ../../language/error_codes/E4219.md:3
msgid "Compiler diagnostic name: `invalid_export_name`."
msgstr ""

#: ../../language/error_codes/E4219.md:5
msgid ""
"The `#export_name` attribute is invalid. Exported names must be unique "
"valid C symbol identifiers, and the attribute may be used only on public,"
" non-generic function definitions without optional arguments in a "
"foreign-library package."
msgstr ""

#: ../../language/error_codes/E4219.md:9
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4219.md:11
msgid ""
"///|\n"
"#export_name(\"bad-name\")\n"
"pub fn add_one(value : Int) -> Int {\n"
"  value + 1\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4219.md:15
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4219.md:17
msgid ""
"Use a valid symbol name and declare the package as a foreign library with"
" `pkgtype(kind: \"foreign_library\")`."
msgstr ""

#: ../../language/error_codes/E4219.md:20
msgid ""
"///|\n"
"#export_name(\"add_one\")\n"
"pub fn add_one(value : Int) -> Int {\n"
"  value + 1\n"
"}\n"
msgstr ""
