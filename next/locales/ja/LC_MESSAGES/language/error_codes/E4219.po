#: ../../language/error_codes/E4219.md:1
msgid "E4219"
msgstr ""

#: ../../language/error_codes/E4219.md:3
msgid "Compiler diagnostic name: `invalid_export_name`."
msgstr ""

#: ../../language/error_codes/E4219.md:5
msgid ""
"The `#export_name` attribute is invalid. MoonBit currently requires "
"exported names to be unique valid C symbol identifiers for every backend."
" The attribute may be used only on public, non-generic function "
"definitions without optional arguments in a foreign-library package."
msgstr ""

#: ../../language/error_codes/E4219.md:11
msgid ""
"Known compiler issue: `#export_name` currently applies its C-symbol-"
"identifier restriction to every backend. WebAssembly export names are "
"UTF-8 strings and are not limited to C identifiers."
msgstr ""

#: ../../language/error_codes/E4219.md:16
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4219.md:18
msgid ""
"///|\n"
"#export_name(\"bad-name\")\n"
"pub fn add_one(value : Int) -> Int {\n"
"  value + 1\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4219.md:22
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4219.md:24
msgid ""
"Use a valid symbol name and declare the package as a foreign library with"
" `pkgtype(kind: \"foreign_library\")`."
msgstr ""

#: ../../language/error_codes/E4219.md:27
msgid ""
"///|\n"
"#export_name(\"add_one\")\n"
"pub fn add_one(value : Int) -> Int {\n"
"  value + 1\n"
"}\n"
msgstr ""

