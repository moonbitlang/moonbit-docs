msgstr "README"

#: ../../toolchain/moon/module.md:151
msgid ""
"The `readme` field is used to specify the path to the module's README "
"file."
msgstr "`readme` 字段用于指定模块的 README 文件的路径。"

#: ../../toolchain/moon/module.md:155
msgid "readme = \"README.md\"\n"
msgstr ""

#: ../../toolchain/moon/module.md:160
