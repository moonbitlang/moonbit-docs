#: ../../language/error_codes/E0089.md:1
msgid "E0089"
msgstr ""

#: ../../language/error_codes/E0089.md:3
msgid "Warning name: `guard_redundant_else`"
msgstr "警告名称：`guard_redundant_else`"

#: ../../language/error_codes/E0089.md:5
msgid ""
"The condition or pattern of a `guard` is exhaustive, so its `else` clause"
" can never run."
msgstr "`guard` 的条件或模式是穷尽的，因此其 `else` 子句永远不会执行。"

#: ../../language/error_codes/E0089.md:8
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E0089.md:10
msgid ""
"///|\n"
"pub fn identity(value : Int) -> Int {\n"
"  guard value is result else { 0 }\n"
"  result\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0089.md:14
msgid "Suggestion"
msgstr "修改建议"

#: ../../language/error_codes/E0089.md:16
msgid "Remove the unreachable `else` clause."
msgstr "删除无法执行的 `else` 子句。"

#: ../../language/error_codes/E0089.md:18
msgid ""
"///|\n"
"pub fn identity(value : Int) -> Int {\n"
"  guard value is result\n"
"  result\n"
"}\n"
msgstr ""
