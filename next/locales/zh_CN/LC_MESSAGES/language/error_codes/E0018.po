#: ../../language/error_codes/E0018.md:1
msgid "E0018"
msgstr ""

#: ../../language/error_codes/E0018.md:3
msgid "Warning name: `useless_loop`"
msgstr ""

#: ../../language/error_codes/E0018.md:5
msgid ""
"This warning applies to the deprecated functional-loop syntax when it has"
" no `continue` statement and therefore executes only once. Use a `for` "
"loop for repeated execution, or `if`/`match` for a single conditional "
"evaluation."
msgstr "此警告针对已弃用的函数式循环语法：没有 `continue` 语句时，循环只执行一次。需要重复执行时请使用 `for` 循环；只需执行一次条件判断时，请使用 `if`/`match`。"

#: ../../language/error_codes/E0018.md:9
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E0018.md:11
msgid ""
"Use explicit state bindings, a condition, and an update clause to count "
"down:"
msgstr "使用显式状态绑定、条件和更新子句实现倒计数："

#: ../../language/error_codes/E0018.md:13
msgid ""
"///|\n"
"fn main {\n"
"  let count = 2\n"
"  for remaining = count; remaining >= 0; remaining = remaining - 1 {\n"
"    println(remaining)\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0018.md:21
#: ../../language/error_codes/E0018.md:36
msgid "Output:"
msgstr "输出："

#: ../../language/error_codes/E0018.md:23
msgid ""
"2\n"
"1\n"
"0\n"
msgstr ""

#: ../../language/error_codes/E0018.md:26
msgid "Use `if`/`match` when no repetition is needed:"
msgstr "不需要重复执行时，请使用 `if`/`match`："

#: ../../language/error_codes/E0018.md:28
msgid ""
"///|\n"
"fn main {\n"
"  let count = 2\n"
"  match count {\n"
"    _..<0 => ()\n"
"    _ => println(count)\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0018.md:38
msgid "2\n"
msgstr ""

#~ msgid "Erroneous example"
#~ msgstr "错误示例"

#~ msgid "Or use `if`/`match` you don't need to use `continue`:"
#~ msgstr "或者如果不需要使用 `continue`，使用 `if`/`match`："
