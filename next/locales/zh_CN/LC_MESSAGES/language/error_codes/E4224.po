#: ../../language/error_codes/E4224.md:1
msgid "E4224"
msgstr ""

#: ../../language/error_codes/E4224.md:3
msgid "Compiler diagnostic name: `lexscan_catchall_missing`."
msgstr ""

#: ../../language/error_codes/E4224.md:5
msgid "A `lexmatch` or `lexscan` expression has no final catch-all case."
msgstr ""

#: ../../language/error_codes/E4224.md:7
msgid ""
"Regex cases do not necessarily cover every possible input, including an "
"empty input. Add a final `_` branch to define the result when no regex "
"case matches."
msgstr ""

#: ../../language/error_codes/E4224.md:10
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4224.md:12
msgid ""
"///|\n"
"pub fn classify(text : String) -> String {\n"
"  lexmatch text with longest {\n"
"    re\"^[a-z]+$\" => \"word\"\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4224.md:16
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4224.md:18
msgid ""
"Add a final `_` case. If a catch-all exists but is not last, see "
"[E4171](E4171.md)."
msgstr ""

#: ../../language/error_codes/E4224.md:21
msgid ""
"///|\n"
"pub fn classify(text : String) -> String {\n"
"  lexmatch text with longest {\n"
"    re\"^[a-z]+$\" => \"word\"\n"
"    _ => \"other\"\n"
"  }\n"
"}\n"
msgstr ""
