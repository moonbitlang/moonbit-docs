#: ../../language/error_codes/E0095.md:1
msgid "E0095"
msgstr ""

#: ../../language/error_codes/E0095.md:3
msgid "Warning name: `nan_pattern`"
msgstr "警告名称：`nan_pattern`"

#: ../../language/error_codes/E0095.md:5
msgid ""
"A pattern uses a floating-point constant whose value is NaN (not a "
"number). NaN is not equal to any value, including itself, so this pattern"
" never matches. This warning is enabled by default."
msgstr "模式使用了值为 NaN（非数）的浮点常量。NaN 不等于任何值，包括它自身，因此此模式永远无法匹配。此警告默认启用。"

#: ../../language/error_codes/E0095.md:9
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E0095.md:11
msgid ""
"///|\n"
"const Infinity : Double = 1.0e308 * 1.0e308\n"
"\n"
"///|\n"
"const NaN : Double = Infinity - Infinity\n"
"\n"
"///|\n"
"pub fn describe(value : Double) -> String {\n"
"  match value {\n"
"    NaN => \"not a number\"\n"
"    _ => \"number\"\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0095.md:15
msgid "The `NaN` branch is not selected even when `value` is NaN."
msgstr "即使 `value` 是 NaN，也不会选择 `NaN` 分支。"

#: ../../language/error_codes/E0095.md:17
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E0095.md:19
msgid ""
"Use `is_nan()` in a match guard instead of matching against a NaN "
"constant:"
msgstr "请在匹配分支的守卫条件中调用 `is_nan()`，而不是使用 NaN 常量进行匹配："

#: ../../language/error_codes/E0095.md:21
msgid ""
"///|\n"
"pub fn describe(value : Double) -> String {\n"
"  match value {\n"
"    x if x.is_nan() => \"not a number\"\n"
"    _ => \"number\"\n"
"  }\n"
"}\n"
"\n"
"///|\n"
"test {\n"
"  inspect(describe(0.0 / 0.0), content=\"not a number\")\n"
"  inspect(describe(1.0), content=\"number\")\n"
"}\n"
msgstr ""
