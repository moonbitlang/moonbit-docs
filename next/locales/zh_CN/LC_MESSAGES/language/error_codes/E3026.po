#: ../../language/error_codes/E3026.md:1
msgid "E3026"
msgstr ""

#: ../../language/error_codes/E3026.md:3
msgid "A `with` pattern is only allowed immediately under an or-pattern."
msgstr "`with` 模式只能直接出现在或模式的下一级。"

#: ../../language/error_codes/E3026.md:5
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E3026.md:7
msgid ""
"///|\n"
"pub fn value_or_zero(value : Int?) -> Int {\n"
"  match value {\n"
"    (None with result = 0) => result\n"
"    Some(result) => result\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E3026.md:11
msgid "Suggestion"
msgstr "修改建议"

#: ../../language/error_codes/E3026.md:13
msgid ""
"Combine the alternative that supplies defaults with another pattern using"
" `|`."
msgstr "请使用 `|` 将提供默认值的分支与另一个模式组合起来。"

#: ../../language/error_codes/E3026.md:15
msgid ""
"///|\n"
"pub fn value_or_zero(value : Int?) -> Int {\n"
"  match value {\n"
"    Some(result) | (None with result = 0) => result\n"
"  }\n"
"}\n"
msgstr ""
