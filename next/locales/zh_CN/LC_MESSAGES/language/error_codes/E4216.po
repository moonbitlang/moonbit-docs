#: ../../language/error_codes/E4216.md:1
msgid "E4216"
msgstr ""

#: ../../language/error_codes/E4216.md:3
msgid "Compiler diagnostic name: `lexscan_catchall_binder_not_supported`."
msgstr ""

#: ../../language/error_codes/E4216.md:5
msgid "A `lexscan` catch-all case uses a binder pattern."
msgstr ""

#: ../../language/error_codes/E4216.md:7
msgid ""
"Streaming cases consume input only when a regex matches. The final catch-"
"all also handles end of input, so it does not bind a matched substring. "
"Use `_` for that case and bind text with `as` on the regex cases that "
"need it."
msgstr ""

#: ../../language/error_codes/E4216.md:11
msgid "Erroneous example"
msgstr ""

#: ../../language/error_codes/E4216.md:13
msgid ""
"///|\n"
"pub fn next_token(lexbuf : @lexbuf.Lexbuf) -> String {\n"
"  lexscan lexbuf {\n"
"    (re\"^[a-z]+\" as word) => word.to_owned()\n"
"    rest => rest.to_owned()\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4216.md:17
msgid "Suggestion"
msgstr ""

#: ../../language/error_codes/E4216.md:19
msgid "Replace the catch-all binder with `_`."
msgstr ""

#: ../../language/error_codes/E4216.md:21
msgid ""
"///|\n"
"pub fn next_token(lexbuf : @lexbuf.Lexbuf) -> String {\n"
"  lexscan lexbuf {\n"
"    (re\"^[a-z]+\" as word) => word.to_owned()\n"
"    _ => \"end\"\n"
"  }\n"
"}\n"
msgstr ""
