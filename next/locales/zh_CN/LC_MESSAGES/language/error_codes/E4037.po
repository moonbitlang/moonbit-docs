#: ../../language/error_codes/E4037.md:1
msgid "E4037"
msgstr ""

#: ../../language/error_codes/E4037.md:3
msgid "Compiler diagnostic name: `pkg_not_imported`."
msgstr "编译器诊断名称：`pkg_not_imported`。"

#: ../../language/error_codes/E4037.md:5
msgid "The referenced package is not imported."
msgstr "引用的包未导入。"

#: ../../language/error_codes/E4037.md:7
msgid ""
"The example refers to `@boolean`, but no package with that alias is "
"imported."
msgstr "此示例引用了 `@boolean`，但没有导入使用该别名的包。"

#: ../../language/error_codes/E4037.md:9
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E4037.md:11
msgid ""
"fn main {\n"
"  println(@boolean.Bool::to_int(true))\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4037.md:15
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E4037.md:17
msgid ""
"Check the package name and import the required package in `moon.pkg`. In "
"this example, `Bool` is a built-in type, so call its method directly "
"without a package alias."
msgstr "检查包名，并在 `moon.pkg` 中导入所需的包。在此示例中，`Bool` 是内置类型，因此直接调用其方法即可，无需包别名。"

#: ../../language/error_codes/E4037.md:21
msgid ""
"fn main {\n"
"  println(true.to_int())\n"
"}\n"
msgstr ""
