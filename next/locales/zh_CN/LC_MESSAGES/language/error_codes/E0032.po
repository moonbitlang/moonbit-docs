#: ../../language/error_codes/E0032.md:1
msgid "E0032"
msgstr ""

#: ../../language/error_codes/E0032.md:3
msgid "Warning name: `unused_default_value`"
msgstr ""

#: ../../language/error_codes/E0032.md:5
msgid ""
"Default value of optional argument is unused. This implies at every call "
"site of this function, the optional argument is always explicitly "
"supplied with a value. This means the optional argument can be refactored"
" into a labelled argument."
msgstr "可选参数的默认值未被使用。这意味着在这个函数的每个调用点，可选参数总是显式地提供一个值。这意味着可选参数可以重构为带标签的参数。"

#: ../../language/error_codes/E0032.md:7
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E0032.md:9
msgid ""
"This warning is turned off by default. Enable it with the `warnings` "
"field in `moon.pkg`:"
msgstr "此警告默认关闭。请通过 `moon.pkg` 中的 `warnings` 字段启用它："

#: ../../language/error_codes/E0032.md:12
msgid "moon.pkg"
msgstr ""

#: ../../language/error_codes/E0032.md:12
msgid ""
"warnings = \"+unused_default_value\"\n"
"\n"
"pkgtype(kind: \"executable\")\n"
msgstr ""

#: ../../language/error_codes/E0032.md:17
msgid "main.mbt"
msgstr ""

#: ../../language/error_codes/E0032.md:17
msgid ""
"///|\n"
"fn f(opt? : Int = 4) -> Int {\n"
"  ignore(opt)\n"
"  0\n"
"}\n"
"\n"
"///|\n"
"fn main {\n"
"  println(f(opt=3))\n"
"  println(f(opt=3))\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0032.md:22
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E0032.md:24
msgid "Turn the optional argument into a labelled argument:"
msgstr "将可选参数转换为带标签的参数："

#: ../../language/error_codes/E0032.md:26
msgid ""
"///|\n"
"fn f(opt~ : Int) -> Int {\n"
"  ignore(opt)\n"
"  0\n"
"}\n"
"\n"
"///|\n"
"fn main {\n"
"  println(f(opt=3))\n"
"  println(f(opt=3))\n"
"}\n"
msgstr ""

