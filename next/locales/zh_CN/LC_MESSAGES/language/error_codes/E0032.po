#: ../../language/error_codes/E0032.md:1
msgid "E0032"
msgstr ""

#: ../../language/error_codes/E0032.md:3
msgid "Warning name: `unused_default_value`"
msgstr ""

#: ../../language/error_codes/E0032.md:5
msgid ""
"The default value of an optional argument is unused: every call site "
"explicitly supplies a value. Remove the default value to make it a required "
"labelled argument, keeping the `~` in its declaration."
msgstr "可选参数的默认值未被使用：所有调用处都显式提供了值。删除默认值即可将其改为必需的标签参数，声明中的 `~` 保持不变。"

#: ../../language/error_codes/E0032.md:7
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E0032.md:9
msgid ""
"This warning is turned off by default. Enable it with the `warnings` "
"field in `moon.pkg`:"
msgstr "此警告默认关闭。请通过 `moon.pkg` 中的 `warnings` 字段启用它："

#: ../../language/error_codes/E0032.md:12
msgid "moon.pkg"
msgstr ""

#: ../../language/error_codes/E0032.md:12
msgid ""
"warnings = \"+unused_default_value\"\n"
"\n"
"pkgtype(kind: \"executable\")\n"
msgstr ""

#: ../../language/error_codes/E0032.md:17
msgid "main.mbt"
msgstr ""

#: ../../language/error_codes/E0032.md:17
msgid ""
"///|\n"
"fn f(opt~ : Int32 = 4) -> Int32 {\n"
"  ignore(opt)\n"
"  0\n"
"}\n"
"\n"
"///|\n"
"fn main {\n"
"  println(f(opt=3))\n"
"  println(f(opt=3))\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E0032.md:22
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E0032.md:24
msgid "Remove the default value to make the labelled argument required:"
msgstr "删除默认值，使该标签参数成为必需参数："

#: ../../language/error_codes/E0032.md:26
msgid ""
"///|\n"
"fn f(opt~ : Int32) -> Int32 {\n"
"  ignore(opt)\n"
"  0\n"
"}\n"
"\n"
"///|\n"
"fn main {\n"
"  println(f(opt=3))\n"
"  println(f(opt=3))\n"
"}\n"
msgstr ""
