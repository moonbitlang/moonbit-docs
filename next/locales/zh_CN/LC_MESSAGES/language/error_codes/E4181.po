#: ../../language/error_codes/E4181.md:1
msgid "E4181"
msgstr ""

#: ../../language/error_codes/E4181.md:3
msgid ""
"Compiler diagnostic name: "
"`named_capture_in_regex_literal_used_in_lex_is_not_supported`."
msgstr ""

#: ../../language/error_codes/E4181.md:5
msgid ""
"Named capture groups are not supported in regex literals used by "
"`lexmatch` or `lexscan`."
msgstr "`lexmatch` 或 `lexscan` 使用的正则字面量不支持具名捕获组。"

#: ../../language/error_codes/E4181.md:8
msgid ""
"`lexmatch` and `lexscan` bind matched text with MoonBit's `as` syntax. "
"Named capture groups inside the regex itself are not part of this binding"
" model."
msgstr "`lexmatch` 和 `lexscan` 使用 MoonBit 的 `as` 语法绑定匹配文本。正则本身内部的具名捕获组不属于这种绑定模型。"

#: ../../language/error_codes/E4181.md:11
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E4181.md:13
msgid ""
"///|\n"
"pub fn match_text(text : String) -> Unit {\n"
"  lexmatch text with longest {\n"
"    re\"^(?<word>abc)$\" => ()\n"
"    _ => ()\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4181.md:17
msgid "The regex contains the named capture group `(?<word>...)`."
msgstr "该正则包含命名捕获组 `(?<word>...)`。"

#: ../../language/error_codes/E4181.md:19
msgid "Suggestion"
msgstr "修改建议"

#: ../../language/error_codes/E4181.md:21
msgid "Use a normal regex group and bind the matched text with `as`."
msgstr "使用普通正则分组，并通过 `as` 绑定匹配文本。"

#: ../../language/error_codes/E4181.md:23
msgid ""
"///|\n"
"pub fn match_text(text : String) -> Unit {\n"
"  lexmatch text with longest {\n"
"    (re\"^(abc)$\" as word) => ignore(word)\n"
"    _ => ()\n"
"  }\n"
"}\n"
msgstr ""
