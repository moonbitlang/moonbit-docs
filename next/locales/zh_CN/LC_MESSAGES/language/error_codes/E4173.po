#: ../../language/error_codes/E4173.md:1
msgid "E4173"
msgstr "E4173"

#: ../../language/error_codes/E4173.md:3
msgid "Compiler diagnostic name: `invalid_value_type_attr`."
msgstr "编译器诊断名称：`invalid_value_type_attr`。"

#: ../../language/error_codes/E4173.md:5
msgid "Invalid `#valtype` declaration."
msgstr "无效的 `#valtype` 声明。"

#: ../../language/error_codes/E4173.md:7
msgid ""
"`#valtype` asks the compiler to represent a type as a value type. Value-"
"type fields must be immutable, so a declaration with a mutable field is "
"rejected."
msgstr ""

#: ../../language/error_codes/E4173.md:10
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E4173.md:12
msgid ""
"#valtype\n"
"struct Counter {\n"
"  mut value : Int\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4173.md:16
msgid "The field `value` is mutable."
msgstr ""

#: ../../language/error_codes/E4173.md:18
msgid "Suggestion"
msgstr "建议"

#: ../../language/error_codes/E4173.md:20
msgid ""
"Make the field immutable, or remove `#valtype` if the type needs in-place"
" mutation."
msgstr ""

#: ../../language/error_codes/E4173.md:23
msgid ""
"#valtype\n"
"struct Point {\n"
"  x : Int\n"
"  y : Int\n"
"}\n"
msgstr ""
