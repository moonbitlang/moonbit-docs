#: ../../language/error_codes/E4171.md:1
msgid "E4171"
msgstr ""

#: ../../language/error_codes/E4171.md:3
msgid "Compiler diagnostic name: `last_regex_case_must_be_catchall`."
msgstr ""

#: ../../language/error_codes/E4171.md:5
msgid ""
"The catch-all case in a `lexmatch` or `lexscan` expression must be the "
"last case."
msgstr ""

#: ../../language/error_codes/E4171.md:8
msgid ""
"Once a catch-all branch is reached, later regex cases can never be "
"selected."
msgstr ""

#: ../../language/error_codes/E4171.md:10
msgid "Erroneous example"
msgstr "错误示例"

#: ../../language/error_codes/E4171.md:12
msgid ""
"///|\n"
"pub fn match_text(text : String) -> Unit {\n"
"  lexmatch text with longest {\n"
"    _ => ()\n"
"    re\"^abc$\" => ()\n"
"  }\n"
"}\n"
msgstr ""

#: ../../language/error_codes/E4171.md:16
msgid "The `_` branch appears before another regex case."
msgstr ""

#: ../../language/error_codes/E4171.md:18
msgid "Suggestion"
msgstr "修改建议"

#: ../../language/error_codes/E4171.md:20
msgid ""
"Move the catch-all branch to the end. If the expression has no catch-all "
"case at all, see [E4224](E4224.md)."
msgstr ""

#: ../../language/error_codes/E4171.md:23
msgid ""
"///|\n"
"pub fn match_text(text : String) -> Unit {\n"
"  lexmatch text with longest {\n"
"    re\"^abc$\" => ()\n"
"    _ => ()\n"
"  }\n"
"}\n"
msgstr ""
