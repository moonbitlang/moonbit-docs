#: ../../language/error_codes/E0034.md:1
msgid "E0034"
msgstr ""

#: ../../language/error_codes/E0034.md:3
msgid "Warning name: `implicit_use_builtin`"
msgstr "警告名称：`implicit_use_builtin`"

#: ../../language/error_codes/E0034.md:5
msgid ""
"This warning was used for constructors implicitly resolved from "
"`moonbitlang/core/builtin`."
msgstr "此警告曾用于从 `moonbitlang/core/builtin` 隐式解析的构造器。"

#: ../../language/error_codes/E0034.md:8
msgid ""
"Current MoonBit no longer emits this warning. Its number and warning name"
" remain listed for compatibility, but unqualified builtin constructors do"
" not require a migration."
msgstr "当前 MoonBit 不再发出此警告。其编号和警告名称仍为兼容性而保留，但未限定名称的 builtin 构造器无需迁移。"
